generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TechnicianVehicleType {
  BIKE
  SCOOTER
  CAR
  NONE
}

enum OrderStatus {
  PENDING
  PENDING_ASSIGNMENT
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

model City {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users            User[]
  orders           Order[]
  zones            ServiceZone[]
  pricingRule      PricingRule[]
  technicians      Technician[]
  serviceOverrides ServiceCityOverride[]
  addresses        Address[]
}

model User {
  id            String             @id @default(cuid())
  role          UserRole
  name          String
  phone         String             @unique
  email         String?            @unique
  passwordHash  String?
  cityId        String?
  city          City?              @relation(fields: [cityId], references: [id])
  technician    Technician?
  customerOrders Order[]           @relation("CustomerOrders")
  ratings       Rating[]           @relation("CustomerRatings")
  addresses     Address[]
  otpCodes      OtpCode[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([role, cityId])
}

model Technician {
  id                  String               @id
  user                User                 @relation(fields: [id], references: [id])
  verificationStatus  VerificationStatus   @default(PENDING)
  isOnline            Boolean              @default(false)
  serviceRadiusKm     Float                @default(5)
  currentLat          Decimal?             @db.Decimal(10, 7)
  currentLng          Decimal?             @db.Decimal(10, 7)
  lastLocationAt      DateTime?
  avgRating           Float                @default(5)
  completedJobs       Int                  @default(0)
  acceptanceRate      Float                @default(1)
  vehicleType         TechnicianVehicleType @default(NONE)
  primaryCityId       String?
  primaryCity         City?                @relation(fields: [primaryCityId], references: [id])
  serviceMappings     TechnicianService[]
  orders              Order[]              @relation("TechnicianOrders")
  ratings             Rating[]             @relation("TechnicianRatings")

  @@index([isOnline, primaryCityId])
  @@index([verificationStatus])
}

model Service {
  id                String               @id @default(cuid())
  category          String
  name              String
  description       String
  basePriceInPaise  Int
  estimatedDuration Int
  isActive          Boolean              @default(true)
  cityOverrides     ServiceCityOverride[]
  technicianMap     TechnicianService[]
  orders            Order[]

  @@index([category, isActive])
}

model ServiceCityOverride {
  id               String   @id @default(cuid())
  serviceId        String
  cityId           String
  overridePrice    Int
  estimatedDuration Int
  service          Service  @relation(fields: [serviceId], references: [id])
  city             City     @relation(fields: [cityId], references: [id])

  @@unique([serviceId, cityId])
}

model TechnicianService {
  id            String      @id @default(cuid())
  technicianId  String
  serviceId     String
  technician    Technician  @relation(fields: [technicianId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@unique([technicianId, serviceId])
}

model ServiceZone {
  id            String   @id @default(cuid())
  cityId        String
  name          String
  polygonJson   Json
  isActive      Boolean  @default(true)
  city          City     @relation(fields: [cityId], references: [id])
  orders        Order[]
  addresses     Address[]

  @@index([cityId, isActive])
}

model PricingRule {
  id             String   @id @default(cuid())
  cityId         String
  category       String
  baseMultiplier Float    @default(1)
  rushMultiplier Float    @default(1)
  city           City     @relation(fields: [cityId], references: [id])

  @@unique([cityId, category])
}

model Order {
  id                    String        @id @default(cuid())
  customerId            String
  technicianId          String?
  serviceId             String
  cityId                String
  zoneId                String?
  status                OrderStatus   @default(PENDING)
  issueType             String
  issueNotes            String?
  mediaUrlsJson         Json?
  preferredTime         DateTime?
  estimatedEtaMinutes   Int?
  estimatedAmountPaise  Int
  finalAmountPaise      Int?
  paymentStatus         PaymentStatus @default(PENDING)
  cancellationReason    String?
  customer              User          @relation("CustomerOrders", fields: [customerId], references: [id])
  technician            Technician?   @relation("TechnicianOrders", fields: [technicianId], references: [id])
  service               Service       @relation(fields: [serviceId], references: [id])
  city                  City          @relation(fields: [cityId], references: [id])
  zone                  ServiceZone?  @relation(fields: [zoneId], references: [id])
  location              Location?
  payment               Payment?
  rating                Rating?
  events                OrderEvent[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  assignedAt            DateTime?
  startedAt             DateTime?
  completedAt           DateTime?

  @@index([customerId, createdAt])
  @@index([technicianId, status])
  @@index([status, cityId])
  @@index([createdAt])
}

model Location {
  id            String   @id @default(cuid())
  orderId       String   @unique
  addressLine   String
  landmark      String?
  floor         String?
  lat           Decimal  @db.Decimal(10, 7)
  lng           Decimal  @db.Decimal(10, 7)
  geohash       String?
  cityId        String
  zoneId        String?
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([cityId, zoneId])
  @@index([lat, lng])
}

model Payment {
  id                     String        @id @default(cuid())
  orderId                String        @unique
  provider               PaymentProvider @default(STRIPE)
  stripePaymentIntentId  String        @unique
  amountPaise            Int
  currency               String        @default("inr")
  status                 PaymentStatus @default(PENDING)
  refundAmountPaise      Int?          @default(0)
  paidAt                 DateTime?
  order                  Order         @relation(fields: [orderId], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
}

model Rating {
  id             String      @id @default(cuid())
  orderId        String      @unique
  customerId     String
  technicianId   String
  score          Int
  comment        String?
  order          Order       @relation(fields: [orderId], references: [id])
  customer       User        @relation("CustomerRatings", fields: [customerId], references: [id])
  technician     Technician  @relation("TechnicianRatings", fields: [technicianId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([technicianId, createdAt])
  @@index([score])
}

model OrderEvent {
  id          String    @id @default(cuid())
  orderId     String
  type        String
  payloadJson Json?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Address {
  id          String       @id @default(cuid())
  userId      String
  cityId      String
  zoneId      String?
  label       AddressLabel @default(HOME)
  addressLine String
  landmark    String?
  floor       String?
  lat         Decimal      @db.Decimal(10, 7)
  lng         Decimal      @db.Decimal(10, 7)
  user        User         @relation(fields: [userId], references: [id])
  city        City         @relation(fields: [cityId], references: [id])
  zone        ServiceZone? @relation(fields: [zoneId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([cityId, zoneId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}
